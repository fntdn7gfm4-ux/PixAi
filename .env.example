APP_ENV=sandbox
PORT=4173
# Generate a random value of at least 32 characters; never put it in frontend code.
ADMIN_TOKEN=
# Placeholders only. An official PSP adapter and homologation are required before use.
PAYMENT_PROVIDER=unconfigured
PSP_SANDBOX_API_KEY=
PSP_PRODUCTION_API_KEY=
PSP_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
KYC_PROVIDER_API_KEY=
# Base64-encoded 32-byte (AES-256) key. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Asaas integration. Keys alone do not enable charging. Sandbox credentials are separate.
ASAAS_ENV=sandbox
PAYMENTS_ENABLED=false
ASAAS_API_KEY=
# Configured in the Asaas dashboard under the regular webhook (Integrations > Webhooks).
ASAAS_WEBHOOK_TOKEN=
# Configured in the Asaas dashboard under Integrations > Security Mechanisms (withdrawal authorization).
ASAAS_WITHDRAWAL_TOKEN=
# Public origin used to build Asaas Checkout callback URLs, e.g. https://pixai.example.com
PUBLIC_BASE_URL=
# Evidence references: complete only after the corresponding review has occurred.
ASAAS_BUSINESS_APPROVAL_REF=
HOMOLOGATION_REPORT_REF=
IDENTITY_REVIEW_PROCESS_REF=
PRICING_REVIEW_REF=
FUNDING_REVIEW_REF=
LEGAL_NAME=
LEGAL_CNPJ=
SUPPORT_EMAIL=
# settled = wait for card settlement; prefunded = own capital with explicit limits.
FUNDING_MODE=prefunded
PREFUND_MAX_OUTSTANDING_CENTS=
PREFUND_RESERVE_CENTS=
